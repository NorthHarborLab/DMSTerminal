package="DSMTerminal"
version="@VERSION@"
os_min_ver="7.2-60000"
displayname="DSM Terminal"
description="SSH and SFTP workspace with encrypted credentials, configurable themes and HTTP fallback."
maintainer="DSM Terminal contributors"
arch="x86_64"
thirdparty="yes"
beta="yes"
offline_install="yes"
silent_upgrade="yes"
support_move="yes"
ctl_stop="yes"
precheckstartstop="yes"
install_dep_packages="Node.js_v22>=22.22.3-1010"
install_dep_services="nginx.service"
start_dep_services="nginx.service network-online.target"
instuninst_restart_services="nginx.service"
startstop_restart_services="nginx.service"
dsmuidir="ui"
dsmappname="org.dsmterminal.App"
dsmapplaunchname="org.dsmterminal.App"
extractsize="@EXTRACT_SIZE@"
